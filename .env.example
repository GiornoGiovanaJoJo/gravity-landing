# Адрес кабинета: куда ведут кнопки «Войти» и «Попробовать».
# На общем домене оставьте пустым — ссылки станут относительными (/login, /register).
# Standalone-деплой (g-neuro.space) собирается с VITE_APP_URL=https://g-neuro.gravityrpa.ru:
# это брендовый хост компании, а не общий вход платформы crm.gravityrpa.ru.
# Для npm run dev значение уже задано в .env.development.
VITE_APP_URL=

# Базовый адрес API. Пусто = тот же origin (в разработке работает через прокси Vite,
# в проде — через прокси nginx на /api/*, см. deploy/nginx.conf).
VITE_API_URL=

# Номер счётчика Яндекс.Метрики. Пусто = счётчика нет совсем: так и надо для
# npm run dev, иначе отладочные визиты смешаются с настоящими в статистике.
# Прод собирается с номером из build-arg в Dockerfile.
VITE_YM_ID=

# Префикс, из которого грузятся ассеты. Пусто = /site/ — сборка для встраивания
# в CRM, где /assets/ уже занят бандлом самой CRM. Для самостоятельного сайта
# в корне домена собирайте с VITE_BASE=/ (так делает Dockerfile).
VITE_BASE=
